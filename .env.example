# ---- Base de datos (Neon Postgres) ----
# Connection string con ?sslmode=require
DATABASE_URL="postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/retia?sslmode=require"
# Rama `production`. Ningun codigo la lee: se usa solo nombrandola en un comando (ADR 0018).
DB_PROD=""

# ---- Auth.js ----
# Genera uno con: npx auth secret
AUTH_SECRET=""
# Credenciales de Google OAuth (Google Cloud Console > APIs y servicios > Credenciales)
# Callback local:      http://localhost:3000/api/auth/callback/google
# Callback produccion: https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Solo en produccion si Vercel no la infiere
# Fijala en produccion. Con trustHost: true, Auth.js arma las URLs de callback desde
# la cabecera Host: sin AUTH_URL, un alias de preview o un X-Forwarded-Host manipulado
# pueden dirigir el flujo.
AUTH_URL="https://<tu-dominio>"

# ---- Seed del primer gerente ----
SEED_GERENTE_EMAIL=""
SEED_GERENTE_NOMBRE="Michael Castellanos"

# ---- Fase 1 en adelante (todavia sin usar) ----
# Service account de Google, JSON completo en base64
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=""
# Secreto para que Vercel Cron pueda disparar la sincronizacion
# CRON_SECRET=""

# ---- IDs de las Google Sheets fuente ----
# La parte de la URL entre /d/ y /edit. No son credenciales, pero son la direccion
# exacta de las dos BBDD con todos los leads: no van escritas en el codigo (S-13).
SHEET_ID_COMUNICARTE=""
SHEET_ID_TACTICAL=""
